# Le resolver strict d'npm échoue sur l'arbre de pairs next/react-dom (race
# arborist + réseau instable) : on revient au comportement hérité, sûr ici car
# react/react-dom restent alignés manuellement entre les workspaces.
legacy-peer-deps=true

# Connexion registre instable : on relarge les délais de reprise.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
