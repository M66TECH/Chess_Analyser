# Copiez ce fichier en .env.local et renseignez vos propres cles.
# NE JAMAIS committer .env.local (il est ignore par git).

# --- Coach IA (routeur River, API compatible OpenAI) ---
# Cle serveur uniquement. Ne jamais prefixer par NEXT_PUBLIC_.
RIVER_API_KEY=your_river_api_key_here

# Ordre de priorite des modeles : le premier qui repond est utilise.
RIVER_MODELS=zai-org/GLM-5.3-Flash,nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4,deepseek-ai/DeepSeek-V4.1-Flash-1017

# --- Base de donnees des ouvertures (Lichess) ---
# Obligatoire : l'explorateur Lichess renvoie 401 sans jeton.
LICHESS_TOKEN=your_lichess_token_here

# masters = parties de maitres (recommandé pour la theorie)
# lichess = toutes les parties (plus de volume, plus bruyant)
LICHESS_EXPLORER_URL=https://explorer.lichess.ovh/masters

# --- Fonctionnalites experimentales (P2.12) ---
# true = arbre de variantes (MoveTree) ; absent/false = liste lineaire (MoveList)
NEXT_PUBLIC_MOVE_TREE_ENABLED=false
