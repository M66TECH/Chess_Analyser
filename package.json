{
  "name": "chess_analyzer",
  "version": "1.0.0",
  "description": "Analyseur et coach pédagogique d'échecs dans le navigateur",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "npm run test --workspaces --if-present",
    "test:p0": "npx tsx scripts/verify-v533-p0-adversarial.ts",
    "test:e2e": "npm run test:e2e --workspace web"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [
    "chess",
    "stockfish",
    "lichess",
    "pedagogy",
    "ai-coach"
  ],
  "author": "M66TECH",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.3",
    "turbo": "^2.10.8",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.66.0"
  }
}
